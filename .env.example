# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffeeshop_dev
DB_USERNAME=coffeeshop
DB_PASSWORD=coffeeshop

# JWT
JWT_SECRET=your-very-long-and-secure-secret-key-at-least-256-bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# OTP
OTP_EXPIRATION_MINUTES=5

# Printer (ESC/POS thermal printer over TCP)
PRINTER_HOST=localhost
PRINTER_PORT=9100
PRINTER_ENABLED=false
PRINTER_TIMEOUT_MS=5000
AUTO_PRINT_ENABLED=false

# Payment - Kaspi
KASPI_API_KEY=your-kaspi-api-key
KASPI_MERCHANT_ID=your-kaspi-merchant-id

# Payment - Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
