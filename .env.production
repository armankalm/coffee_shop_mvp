# Coffee Shop System — Production Environment
# Скопируй этот файл в .env и заполни значения

# ===== Database =====
DB_NAME=coffeeshop
DB_USERNAME=coffeeshop
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== JWT Security =====
# Сгенерируй: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_MIN_256_BITS_SECRET_KEY
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ===== Email (OTP) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_app_password

# ===== Kaspi Pay =====
KASPI_API_KEY=your_kaspi_api_key
KASPI_MERCHANT_ID=your_kaspi_merchant_id

# ===== Stripe =====
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===== Thermal Printer =====
PRINTER_ENABLED=false
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
