# Database (Supabase -> Connect -> Session pooler, NOT the direct connection: Render has no IPv6)
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require
DB_POOL_SIZE=5
# Add classpath:db/seed to load test data (keep it once applied, Flyway validates history)
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# CORS (frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

# JWT (use a cryptographically random key, at least 256 bits)
JWT_SECRET=your-very-long-and-cryptographically-secure-secret-key-minimum-256-bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Mail: Brevo HTTP API. Empty BREVO_API_KEY -> OTP code is returned in the API response (dev only)
BREVO_API_KEY=
MAIL_FROM_ADDRESS=your-verified-sender@gmail.com
MAIL_FROM_NAME=Coffee Shop

# Google sign-in (redirect URI: <BACKEND_URL>/api/auth/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_URL=https://your-backend.onrender.com
FRONTEND_URL=https://your-frontend.onrender.com

# Product images in Supabase Storage (public bucket). Empty SUPABASE_URL -> local disk
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=products

# OTP
OTP_EXPIRATION_MINUTES=5

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Printer (thermal ESC/POS)
PRINTER_HOST=your-printer-ip
PRINTER_PORT=9100
PRINTER_ENABLED=false
PRINTER_TIMEOUT_MS=5000
AUTO_PRINT_ENABLED=false

# Payment - Kaspi
KASPI_MERCHANT_ID=your-kaspi-merchant-id
KASPI_API_KEY=your-kaspi-api-key
KASPI_API_URL=https://api.kaspi.kz/pay/v1
KASPI_WEBHOOK_SECRET=your-kaspi-webhook-secret

