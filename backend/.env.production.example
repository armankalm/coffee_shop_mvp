# Database (Supabase -> Connect -> Session pooler, NOT the direct connection: Render has no IPv6)
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require
DB_POOL_SIZE=5
# Add classpath:db/seed to load test data (keep it once applied, Flyway validates history)
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# JWT (use a cryptographically random key, at least 256 bits)
JWT_SECRET=your-very-long-and-cryptographically-secure-secret-key-minimum-256-bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Mail: Brevo HTTP API (https://app.brevo.com -> SMTP & API -> API Keys), key looks like xkeysib-...
# Leave BREVO_API_KEY empty locally -> dev-mode: the OTP code is returned in the API response instead of emailed.
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Must be a verified sender in Brevo (Senders -> add and confirm the address)
MAIL_FROM_ADDRESS=your-verified-sender@gmail.com
MAIL_FROM_NAME=Coffee Shop

# Google sign-in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: <BACKEND_URL>/api/auth/oauth/google/callback
# Leave empty to disable the "Sign in with Google" flow.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
# BACKEND_URL / FRONTEND_URL / CORS_ALLOWED_ORIGINS: not needed on Render. The frontend is served
# by the same service and RENDER_EXTERNAL_URL is used; set them only when hosting elsewhere.

# Product images in Supabase Storage (public bucket). Empty SUPABASE_URL -> local disk
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API Keys -> Legacy -> service_role (server-side only, never expose to the browser)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=products

# OTP
OTP_EXPIRATION_MINUTES=5

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Printer (thermal ESC/POS)
PRINTER_HOST=your-printer-ip
PRINTER_PORT=9100
PRINTER_ENABLED=false
PRINTER_TIMEOUT_MS=5000
AUTO_PRINT_ENABLED=false

# Payment - Kaspi
KASPI_MERCHANT_ID=your-kaspi-merchant-id
KASPI_API_KEY=your-kaspi-api-key
KASPI_API_URL=https://api.kaspi.kz/pay/v1
KASPI_WEBHOOK_SECRET=your-kaspi-webhook-secret

