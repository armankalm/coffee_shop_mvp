# Local dev only. The production image builds with VITE_API_ORIGIN="" so the app calls /api on its own host.
VITE_API_ORIGIN=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api
# Product photos: unsigned upload straight to Cloudinary, one folder per shop (coffee-mvp/shop-<id>/products).
VITE_CLOUDINARY_CLOUD_NAME=zkdcguxg
VITE_CLOUDINARY_UPLOAD_PRESET=course_project
